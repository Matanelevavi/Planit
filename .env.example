# Copy to .env and fill in. NEVER commit the real .env.

# Database password (used by the postgres container and the API)
POSTGRES_PASSWORD=change-me

# Signs login tokens. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PLANIT_SECRET_KEY=

# Where the web app is served from (JSON list). Must match the browser's address.
PLANIT_CORS_ORIGINS=["http://localhost:8080"]

# true when served over HTTPS (required in production). For a plain-http local trial of the
# production stack set false - but PLANIT_ENV=prod refuses to start without it, so use the
# dev setup in the README for local development instead.
PLANIT_COOKIE_SECURE=true
